    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.6.0",
    "postcss-lit": "^1.4.1",
    "prettier": "3.8.3",
    "release-it": "^20.0.1",
    "stylelint": "^17.11.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
