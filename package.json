{
  "name": "@tinfoilhash/verify",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "verify the integrity of a file with the largest decentralized web of trust",
  "bugs": "https://github.com/tinfoilhash/verify/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinfoilhash/verify.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:format && npm run lint:quality && npm run lint:style",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write .",
    "lint:quality": "eslint .",
    "lint:quality:fix": "eslint --fix .",
    "lint:style": "stylelint '**/*.js'",
